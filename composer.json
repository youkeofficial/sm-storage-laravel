{
    "name": "youkeofficial/sm-storage-laravel",
    "description": "Laravel Flysystem adapter for SmStorage SaaS",
    "type": "library",
    "license": "MIT",
    "authors": [
        {
            "name": "Youssouf Konaté",
            "email": "ykbass50@gmail.com"
        }
    ],
    "require": {
        "php": "^8.1",
        "illuminate/support": "^10.0|^11.0|^12.0",
        "illuminate/filesystem": "^10.0|^11.0|^12.0",
        "illuminate/http": "^10.0|^11.0|^12.0",
        "league/flysystem": "^3.0"
    },
    "autoload": {
        "psr-4": {
            "Youke\\SmStorage\\": "src/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Youke\\SmStorage\\SmStorageServiceProvider"
            ]
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}